{
  "name": "quordle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:data && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:dictionary": "node --import tsx scripts/validate-dictionary.ts",
    "calendar:generate": "node --import tsx scripts/generate-daily-calendar.ts",
