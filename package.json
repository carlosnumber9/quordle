    "validate:data": "npm run validate:dictionary && npm run calendar:validate"
  },
  "dependencies": {
    "@astrojs/react": "latest",
    "@astrojs/vercel": "latest",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "3.15.0",
    "next-themes": "^0.4.6",
    "react": "latest",
    "react-dom": "latest",
    "shadcn": "^4.14.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
